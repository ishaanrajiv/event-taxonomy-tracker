{
  "name": "event-taxonomy-tracker",
  "private": true,
  "version": "3.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm run dev --workspace @tracker/api\" \"npm run dev --workspace @tracker/web\"",
    "dev:api": "npm run dev --workspace @tracker/api",
    "dev:web": "npm run dev --workspace @tracker/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
