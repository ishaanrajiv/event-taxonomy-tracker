# Event Taxonomy Tracker - Environment Configuration

# ============================================
# Vercel AI Gateway (REQUIRED for AI features)
# ============================================

# Vercel API key for AI Gateway access
# Get your key: https://vercel.com/account/api-tokens
AI_GATEWAY_API_KEY=

# Model to use in "provider:model" format (default: openai/gpt-5-nano)
# Examples:
#   openai/gpt-5-nano
#   openai:gpt-4o
#   google:gemini-2.0-flash-exp
# LLM_MODEL=openai/gpt-5-nano

# ============================================
# Server Configuration (Optional)
# ============================================

# Server port (default: 8000)
# PORT=8000

# Server host (default: 0.0.0.0 for all interfaces)
# HOST=0.0.0.0

# ============================================
# Database Configuration (Optional)
# ============================================

# Custom database path (default: apps/api/data/event_taxonomy.db)
# DB_PATH=/custom/path/to/database.db

# ============================================
# Quick Start
# ============================================

# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Add your Vercel API key:
#    AI_GATEWAY_API_KEY=your_key_here
#
# 3. Start the server:
#    bun run dev
