# Event Taxonomy Tracker API - Environment Configuration

# ============================================
# LLM Configuration (REQUIRED for AI features)
# ============================================

# Choose your LLM provider (default: anthropic)
# Options: anthropic | openai | google
LLM_PROVIDER=anthropic

# Optional: Override the default model for your chosen provider
# LLM_MODEL=claude-sonnet-4-20250514

# --- Anthropic (Claude) ---
# Default model: claude-sonnet-4-20250514 (Sonnet 4.5)
# Get your key: https://console.anthropic.com/settings/keys
# Cost: ~$3 input / ~$15 output per million tokens
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- OpenAI (GPT) ---
# Default model: gpt-4o
# Get your key: https://platform.openai.com/api-keys
# Cost: ~$2.50 input / ~$10 output per million tokens
# OPENAI_API_KEY=sk-...

# --- Google (Gemini) ---
# Default model: gemini-2.0-flash-exp
# Get your key: https://aistudio.google.com/app/apikey
# Cost: Free tier available, then ~$0.075 input / ~$0.30 output per million tokens
# GOOGLE_GENERATIVE_AI_API_KEY=...

# ============================================
# Server Configuration (Optional)
# ============================================

# Server port (default: 8000)
# PORT=8000

# Server host (default: 0.0.0.0 for all interfaces)
# HOST=0.0.0.0

# ============================================
# Database Configuration (Optional)
# ============================================

# Custom database path (default: apps/api/data/event_taxonomy.db)
# Use this to override the default SQLite database location
# DB_PATH=/custom/path/to/database.db

# ============================================
# Quick Start
# ============================================

# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Choose a provider and add your API key:
#    - For Anthropic: Set ANTHROPIC_API_KEY (recommended, best quality)
#    - For OpenAI: Set LLM_PROVIDER=openai and OPENAI_API_KEY
#    - For Google: Set LLM_PROVIDER=google and GOOGLE_GENERATIVE_AI_API_KEY
#
# 3. Start the server:
#    bun run dev
#
# 4. The API will be available at: http://localhost:8000
#
# 5. Test event generation by creating a tracking plan and clicking "Generate"

# ============================================
# Model Recommendations
# ============================================

# Best Quality: Anthropic Claude Sonnet 4.5 (default)
# - Most accurate event generation
# - Best understanding of product requirements
# - Structured output works reliably
#
# Fast & Cheap: Google Gemini 2.0 Flash
# - Free tier available
# - Very fast response times
# - Good for rapid prototyping
#
# Balanced: OpenAI GPT-4o
# - Good quality-to-cost ratio
# - Widely available
# - Reliable structured outputs
